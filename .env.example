# 复制为 .env 后填入真实值；.env 不会被提交
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# 高德 Web 服务 API（注意：必须是「Web服务」类型的 Key，不是 Web端 JS API）
AMAP_MAPS_API_KEY=

# Web 搜索（RAG 兜底用，可留空）
TAVILY_API_KEY=

# 向量化 / 多模态（RAG 阶段用）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# 可观测（可选）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=travel-agent
